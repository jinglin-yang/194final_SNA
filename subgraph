set.seed(234)
get_connected_subgraph <- function(network, target_size = 200) {
  start  <- sample(V(network), 1)
  nearby <- ego(network, order = 8, nodes = start)[[1]]  # order=3 for more nodes
  if(length(nearby) >= target_size) {
    sample(nearby, target_size)  # randomly sample 200 from neighborhood
  } else {
    nearby  # take all if less than 200
  }
}

